programa {
  funcao real calculoArea(real base, real altura) {
    retorne base * altura
  }
  funcao inicio() {
    real b, a

    escreva ("Digite o número da base em cm: ")
    leia (b)

    escreva ("Digite o  número da base em cm: ")
    leia (a)

    escreva ("A área do retângulo é: ",calculoArea(b,a), "cm²")
  }
}
